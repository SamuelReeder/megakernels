#!/bin/bash
# Compile a model's decode kernel (4 layers, 1 step of tests/test_decode.py) with IR dumps
# and print the register / spill statistics. Runs in the model directory on the compute
# node: common/scripts/mkrun <model-dir> '../common/scripts/isa_stats WEIGHTS [M]'
set -uo pipefail
W=$1
M=${2:-1}
D=/tmp/isa_stats_$$
rm -rf "$D"
FLYDSL_RUNTIME_ENABLE_CACHE=0 FLYDSL_DUMP_IR=1 FLYDSL_DUMP_DIR=$D timeout 600 \
    python tests/test_decode.py "$W" "$M" 4 1 2>&1 | tail -1
f=$(ls "$D"/*/22_final_isa.s | head -1)
grep -E '^ +\.(vgpr_count|vgpr_spill_count|sgpr_spill_count|private_segment_fixed_size):' "$f"
echo "scratch ops $(grep -c scratch_ "$f")"
rm -rf "$D"
