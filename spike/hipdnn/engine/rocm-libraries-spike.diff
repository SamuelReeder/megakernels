diff --git a/dnn-providers/hip-kernel-provider/src/engines/kernel_ingestor_engine/descriptors/megakernel/qwen38_standin/MegakernelStandIn.cpp b/dnn-providers/hip-kernel-provider/src/engines/kernel_ingestor_engine/descriptors/megakernel/qwen38_standin/MegakernelStandIn.cpp
new file mode 100644
index 00000000000..2e1c02159ba
--- /dev/null
+++ b/dnn-providers/hip-kernel-provider/src/engines/kernel_ingestor_engine/descriptors/megakernel/qwen38_standin/MegakernelStandIn.cpp
@@ -0,0 +1,20 @@
+// Spike stand-in for the FlyDSL decode megakernel: same ABI as kdec(tab: Int64, glob: Int64,
+// nlayers: Int32). It writes a pattern that names its build variant (M) into the buffer that
+// `glob` points to, and copies tab[0] into the last word, so a test can see which packed
+// binary ran and that both pointers arrived.
+#include <hip/hip_runtime.h>
+#include <stdint.h>
+
+extern "C" __global__ void qwen38_decode_standin(int64_t tab, int64_t glob, int32_t nlayers)
+{
+    const uint64_t i = static_cast<uint64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const uint64_t n = static_cast<uint64_t>(gridDim.x) * blockDim.x;
+    auto* out = reinterpret_cast<uint64_t*>(glob);
+    const auto* in = reinterpret_cast<const uint64_t*>(tab);
+    out[i] = (0x4D4Bull << 48) | (static_cast<uint64_t>(MK_STANDIN_M) << 40)
+             | (static_cast<uint64_t>(static_cast<uint32_t>(nlayers) & 0xFFu) << 32) | i;
+    if(i == 0)
+    {
+        out[n] = in[0];
+    }
+}
