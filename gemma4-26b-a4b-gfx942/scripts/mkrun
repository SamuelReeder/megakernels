#!/bin/bash
# Ship this model directory to the held gfx942 allocation and run a command in it.
# The sources go to the compute node's /tmp/g4src-<run id> (tar over srun stdin, removed
# afterwards); nothing is written to a shared sync folder. $G4 points at the checkpoints
# (default ~/mk/models; scripts/stage_models.sh stages them in node /tmp instead).
# $OUT (default ~/mk/g4out) is where long runs write their logs.
# Usage: scripts/mkrun [-j JOBID] '<shell command run in the shipped directory>'
# JOBID defaults to $MK_JOB or the running job named g4dev.
set -euo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
job=${MK_JOB:-}
if [ "${1:-}" = "-j" ]; then job=$2; shift 2; fi
if [ -z "$job" ]; then job=$(ssh -o BatchMode=yes alola 'squeue -h -u $USER -n g4dev -t R -o %i | head -1'); fi
[ -n "$job" ] || { echo "no g4dev allocation" >&2; exit 2; }
src=/tmp/g4src-$(date +%s%N)
# REVISION: the commit and the number of uncommitted files of the shipped tree
(cd "$here" && echo "$(git rev-parse HEAD) dirty files: $(git status --porcelain . | wc -l)") > "$here/REVISION"
tar -C "$here" --exclude __pycache__ --exclude results -cf - . | ssh -o BatchMode=yes alola \
  "srun --jobid=$job --overlap -n1 --time=2 bash -c 'mkdir -p $src && tar -xf - -C $src'"
cmd="$*"
ssh -o BatchMode=yes alola "srun --jobid=$job --overlap -n1 --time=${MK_TIME:-20} \
  --container-image=/cluster/images/hipdnn/hipdnn_latest_gfx942.sqsh \
  --container-mounts=/cluster:/cluster,/home/AMD/sareeder:/home/AMD/sareeder,/tmp:/tmp \
  --container-name=g4 bash -lc 'export PIP_CACHE_DIR=/tmp/pipcache FLYDSL_RUNTIME_ENABLE_CACHE=0 PYTHONPYCACHEPREFIX=/tmp/pycache G4=\${G4:-\$HOME/mk/models} OUT=\${OUT:-\$HOME/mk/g4out}; mkdir -p \$OUT; [ -f \$HOME/mk/venv/bin/activate ] && . \$HOME/mk/venv/bin/activate; cd $src && echo node \$(hostname) job $job >&2; $cmd; rc=\$?; rm -rf $src; exit \$rc' 2>&1"
