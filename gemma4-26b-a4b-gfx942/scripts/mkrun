#!/bin/bash
# Ship this model directory to the held gfx942 allocation and run a command in it.
# The sources go straight to the compute node (/tmp/g4src-<run id>, tar over srun stdin,
# removed afterwards): nothing is written to the Alola home, which is at its quota. $G4
# points at the checkpoints (default /tmp/g4models, see scripts/stage_models.sh).
# Usage: scripts/mkrun [-j JOBID] '<shell command run in the shipped directory>'
# JOBID defaults to $MK_JOB or the running job named mkdev.
set -euo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
job=${MK_JOB:-}
if [ "${1:-}" = "-j" ]; then job=$2; shift 2; fi
if [ -z "$job" ]; then job=$(ssh -o BatchMode=yes alola 'squeue -h -u $USER -n mkdev -t R -o %i | head -1'); fi
[ -n "$job" ] || { echo "no mkdev allocation" >&2; exit 2; }
src=/tmp/g4src-$(date +%s%N)
tar -C "$here" --exclude __pycache__ -cf - . | ssh -o BatchMode=yes alola \
  "srun --jobid=$job --overlap -n1 --time=2 bash -c 'mkdir -p $src && tar -xf - -C $src'"
cmd="$*"
ssh -o BatchMode=yes alola "srun --jobid=$job --overlap -n1 --time=${MK_TIME:-20} \
  --container-image=/cluster/images/hipdnn/hipdnn_latest_gfx942.sqsh \
  --container-mounts=/cluster:/cluster,/home/AMD/sareeder:/home/AMD/sareeder,/tmp:/tmp \
  --container-name=g4 bash -lc 'export PIP_CACHE_DIR=/tmp/pipcache FLYDSL_RUNTIME_ENABLE_CACHE=0 PYTHONPYCACHEPREFIX=/tmp/pycache G4=\${G4:-/tmp/g4models}; [ -f \$HOME/mk/venv/bin/activate ] && . \$HOME/mk/venv/bin/activate; cd $src && $cmd; rc=\$?; rm -rf $src; exit \$rc' 2>&1"
