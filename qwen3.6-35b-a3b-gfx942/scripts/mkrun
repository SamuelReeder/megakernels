#!/bin/bash
# Sync this directory to Alola and run a command in the held gfx942 allocation.
# Usage: scripts/mkrun [-j JOBID] '<shell command run in ~/$MK_SRC>'
# JOBID defaults to $MK_JOB or the running job named mk36. Models: ~/mk/models.
# MK_SRC (default mk/src36): the sync folder under the cluster home, one per branch.
set -euo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
job=${MK_JOB:-}
if [ "${1:-}" = "-j" ]; then job=$2; shift 2; fi
if [ -z "$job" ]; then job=$(ssh -o BatchMode=yes alola 'squeue -h -u $USER -n mk36 -t R -o %i | head -1'); fi
[ -n "$job" ] || { echo "no mk36 allocation" >&2; exit 2; }
# bench/results/ is written on the cluster: never deleted there, copied back after the run
src=${MK_SRC:-mk/src36}
rsync -a --delete --exclude .git --exclude __pycache__ --exclude bench/results/ "$here/" "alola:$src/"
cmd="$*"
ssh -o BatchMode=yes alola "srun --jobid=$job --overlap -n1 --time=${MK_TIME:-20} \
  --container-image=/cluster/images/hipdnn/hipdnn_latest_gfx942.sqsh \
  --container-mounts=/cluster:/cluster,/home/AMD/sareeder:/home/AMD/sareeder \
  --container-name=mk36 bash -lc 'export PIP_CACHE_DIR=/tmp/pipcache FLYDSL_RUNTIME_ENABLE_CACHE=0 M=\$HOME/mk/models; [ -f \$HOME/mk/venv/bin/activate ] && . \$HOME/mk/venv/bin/activate; cd \$HOME/$src && $cmd' 2>&1" || rc=$?
rsync -a "alola:$src/bench/results/" "$here/bench/results/" 2>/dev/null || true
exit ${rc:-0}
